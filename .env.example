# ===== KingTele - cấu hình =====
NODE_ENV=production
PORT=3000

# Tài khoản đăng nhập trang quản trị (BẮT BUỘC đặt mật khẩu mạnh)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-manh-o-day

# Token bot từ @BotFather (có thể nhập sau trong Cài đặt)
TELEGRAM_BOT_TOKEN=

# Múi giờ mặc định
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Thư mục lưu dữ liệu (nên là nơi không bị xoá khi deploy lại)
DATA_DIR=./data

# ===== Nhiều thành viên (không bắt buộc) =====
# Đặt 0 để đóng đăng ký tài khoản mới
REGISTRATION_OPEN=1
MAX_USERS=2000
MAX_GROUPS_PER_USER=30
MAX_POSTS_PER_USER=100
MAX_UPLOAD_MB_PER_USER=300

# ===== Điểm King (không bắt buộc, đây là giá trị mặc định) =====
SIGNUP_POINTS=500
CHECKIN_POINTS=50
REFERRER_BONUS=1000
REFEREE_BONUS=1000
POINTS_PER_SEND=1
# Địa chỉ gốc để tạo link giới thiệu (mặc định lấy từ tên miền đang truy cập)
BASE_URL=https://kingtele.com
