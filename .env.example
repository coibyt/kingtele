# ===== PostPilot - cấu hình =====
NODE_ENV=production
PORT=3000

# Tài khoản đăng nhập trang quản trị (BẮT BUỘC đặt mật khẩu mạnh)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-manh-o-day

# Token bot từ @BotFather (có thể nhập sau trong Cài đặt)
